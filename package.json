{
  "name": "@demian85/home-server",
  "version": "4.0.0",
  "description": "Smart Home server",
  "type": "module",
  "main": "build/src/index.js",
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/demian85/home-server.git"
  },
  "scripts": {
    "postinstall": "npm run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('build', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc && tsc-alias -f -fe .js",
    "typecheck": "tsc --noEmit",
    "start": "tsx src/index.ts",
    "dev": "LOG_PRETTY=true tsx watch src/index.ts",
    "lint": "eslint ./src",
    "format": "prettier --write './src/**/*.{js,jsx,ts,tsx}'",
    "test": "jest --detectOpenHandles --passWithNoTests",
    "docker:start": "docker compose up --build -d",
    "docker:restart": "docker compose down && docker compose up --build -d",
    "docker:logs": "docker logs -f home-server-app-1 -n 100 -f | pino-pretty"
  },
  "keywords": [
    "sonoff",
    "smart",
    "home",
    "mqtt",
    "server",
    "esp8266",
    "wemos",
    "domotics",
    "automation",
    "shelly"
  ],
  "author": "Demian Rodriguez",
  "license": "ISC",
  "dependencies": {
    "@telegraf/types": "^9.2.1",
    "dotenv": "^16.0.2",
    "lodash": "^4.17.21",
    "luxon": "^3.3.0",
    "mqtt": "^4.3.7",
    "openai": "^3.2.1",
    "pino": "^8.4.2",
    "redis": "^4.7.1",
    "telegraf": "^4.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tsconfig/node22": "^22.0.1",
    "@types/lodash": "^4.17.24",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.3",
    "ts-jest": "^29.4.9",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  }
}
